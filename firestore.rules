rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'admin@shopity.com';
    }
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'category', 'usd', 'stock', 'rocket', 'specs', 'img'])
        && request.resource.data.usd is number && request.resource.data.usd > 0
        && request.resource.data.stock is int && request.resource.data.stock >= 0;
      allow delete: if isAdmin();
    }
    match /orders/{orderId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.customerEmail == request.auth.token.email
        && request.resource.data.totalUsd is number && request.resource.data.totalUsd > 0;
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
  }
}